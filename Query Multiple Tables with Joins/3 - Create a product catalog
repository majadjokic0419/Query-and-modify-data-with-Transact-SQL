-- Challenge 3: Create a product catalog

-- 1. Retrieve product information by category

SELECT 
    parent.Name AS ParentCategoryName,
    cat.Name AS SubCategoryName,
    p.Name AS ProductName
FROM SalesLT.ProductCategory AS cat
JOIN SalesLT.ProductCategory AS parent
    ON cat.ParentProductCategoryID = parent.ProductCategoryID
JOIN SalesLT.Product AS p
    ON cat.ProductCategoryID = p.ProductCategoryID
ORDER BY ParentCategoryName, SubCategoryName, ProductName;

